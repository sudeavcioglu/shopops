# Kopyala: cp .env.example .env  (.env asla commit'lenmez)
# Varsayılan LLM: Google Gemini ücretsiz katman (AI Studio anahtarı)
GEMINI_API_KEY=
# Yedek: Groq ücretsiz katman
GROQ_API_KEY=
# Tamamen yerel yol: Ollama (anahtar gerekmez)
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=gemini        # gemini | groq | ollama
LLM_MODEL=                 # config.py'deki varsayılanı geçersiz kılmak için
LLM_TEMPERATURE=0
# Veri
SHOPOPS_DB=data/shopops.db
